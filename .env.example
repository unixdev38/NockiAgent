# ============================================================================
# Nocki Agent — example configuration
# Copy this file to `.env` and adjust the values for your machine.
# Never commit your real `.env` (it is git-ignored).
# ============================================================================

# --- LLM / Ollama -----------------------------------------------------------
# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Model name as known by Ollama. Interchangeable: gemma3:1b, qwen3, llama3, ...
OLLAMA_MODEL=gemma3:1b
# Sampling temperature (0.0 = deterministic).
LLM_TEMPERATURE=0.3
# Request timeout (seconds) for a single LLM call.
LLM_REQUEST_TIMEOUT=120

# --- Agent workflow ---------------------------------------------------------
# Hard cap on reasoning/tool iterations to avoid infinite loops.
MAX_ITERATIONS=8
# Global timeout (seconds) for a full agent run.
AGENT_TIMEOUT=120

# --- Workspace --------------------------------------------------------------
# The ONLY directory the agent is allowed to read from / operate in.
# Use forward slashes on Windows too, e.g. C:/Users/HP/Projects
WORKSPACE_PATH=./workspace

# --- Security (permissions applied independently of the model) ---------------
# Allow arbitrary shell execution (DANGEROUS — keep false).
ALLOW_SHELL=false
# Allow the agent to write/modify files.
ALLOW_FILE_WRITE=false
# Require explicit user confirmation before WRITE / EXECUTE actions.
REQUIRE_CONFIRMATION=true

# --- Memory (Phase 3) -------------------------------------------------------
# SQLite database file for persistent memory.
DATABASE_PATH=./data/nocki.db

# --- Observability ----------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
