# ============================================================================
# Nocki Agent — example configuration
# Copy this file to `.env` and adjust the values for your machine.
# Never commit your real `.env` (it is git-ignored).
# ============================================================================

# --- LLM provider -----------------------------------------------------------
# 'ollama'     : modèle LOCAL via Ollama (défaut, rien ne quitte la machine)
# 'openrouter' : modèle CLOUD open-source via OpenRouter (https://openrouter.ai)
LLM_PROVIDER=ollama

# --- OpenRouter (utilisé seulement si LLM_PROVIDER=openrouter) -------------------
# Clé API : https://openrouter.ai/keys  (ne jamais la committer)
OPENROUTER_API_KEY=
# Modèle open-source léger supportant les outils. Liste à jour :
#   https://openrouter.ai/models?supported_parameters=tools
# Exemples : qwen/qwen3-8b, meta-llama/llama-3.1-8b-instruct, openai/gpt-oss-20b
OPENROUTER_MODEL=qwen/qwen3-8b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optionnels : affichés chez OpenRouter (classement des applications)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Nocki Agent

# --- LLM / Ollama -----------------------------------------------------------
# Base URL of the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Model name as known by Ollama. Interchangeable: gemma3:1b, qwen3, llama3, ...
OLLAMA_MODEL=gemma3:1b
# Sampling temperature (0.0 = deterministic).
LLM_TEMPERATURE=0.3
# Request timeout (seconds) for a single LLM call.
LLM_REQUEST_TIMEOUT=120

# --- MCP (serveurs d'outils externes) ----------------------------------------------
# Fichier JSON listant les serveurs MCP (voir mcp_servers.example.json).
# Absent = aucun serveur MCP.
MCP_CONFIG_PATH=./mcp_servers.json
# Autorise les outils MCP d'écriture/exécution (les outils permission "read" sont
# toujours disponibles). Désactivé par défaut.
ALLOW_MCP_TOOLS=false
# Délai maximum (s) pour connecter tous les serveurs MCP au démarrage.
MCP_STARTUP_TIMEOUT=30

# --- Agent workflow ---------------------------------------------------------
# Hard cap on reasoning/tool iterations to avoid infinite loops.
MAX_ITERATIONS=8
# Global timeout (seconds) for a full agent run.
AGENT_TIMEOUT=120

# --- Workspace --------------------------------------------------------------
# The ONLY directory the agent is allowed to read from / operate in.
# Use forward slashes on Windows too, e.g. C:/Users/HP/Projects
WORKSPACE_PATH=./workspace

# --- Security (permissions applied independently of the model) ---------------
# Allow arbitrary shell execution (DANGEROUS — keep false).
ALLOW_SHELL=false
# Allow the agent to write/modify files.
ALLOW_FILE_WRITE=false
# Allow the agent to run Python code in the sandbox subprocess.
ALLOW_PYTHON_EXEC=false
# Require explicit user confirmation before WRITE / EXECUTE actions.
REQUIRE_CONFIRMATION=true

# --- Tools -------------------------------------------------------------------
# Max size (bytes) of a single file read.
MAX_FILE_READ_BYTES=200000
# Max matches returned by search_code.
SEARCH_MAX_RESULTS=50
# Max files scanned by search_code.
SEARCH_MAX_FILES=2000
# Wall-clock timeout (seconds) for one sandboxed Python execution.
PYTHON_EXEC_TIMEOUT=10

# --- Memory (Phase 3) -------------------------------------------------------
# SQLite database file for persistent memory.
DATABASE_PATH=./data/nocki.db

# --- Uploads (interface web) ------------------------------------------------------
# Sous-dossier du workspace où sont déposés les documents envoyés depuis le chat.
UPLOAD_SUBDIR=uploads
# Taille maximale d'un fichier envoyé (octets). 10 Mo par défaut.
UPLOAD_MAX_BYTES=10000000

# --- API (Phase 5) ------------------------------------------------------------
# Bind host/port of the FastAPI server (python -m app.api).
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability ----------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
